# Public identifier only. Do not expose Clerk secret keys, Neon URLs, or vendor credentials.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_API_URL=https://your-deployment.example.com

# Server-only Vercel environment variables
CLERK_SECRET_KEY=sk_test_replace_me
DATABASE_URL=postgresql://replace-with-neon-connection-string

# Server-only AI settings. The mobile client never receives these values.
OPENAI_API_KEY=sk_replace_me
